{
  "name": "roco-kingdom-world-guide",
  "productName": "Roco Kingdom World Field Guide",
  "version": "1.0.0",
  "description": "An offline desktop companion to the independent Roco Kingdom: World field guide.",
  "author": "Ding-Ding-Projects",
  "license": "MIT",
  "homepage": "https://ding-ding-projects.github.io/roco-kingdom-world-guide/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ding-Ding-Projects/roco-kingdom-world-guide.git"
  },
  "main": "desktop/main.cjs",
  "scripts": {
    "prepare:build": "node scripts/generate-app-icon.mjs && node scripts/write-build-provenance.mjs",
    "start": "electron .",
    "prestart": "npm run prepare:build",
    "package": "electron-forge package",
    "prepackage": "npm run prepare:build",
    "make": "electron-forge make",
    "premake": "npm run prepare:build"
  },
  "dependencies": {
    "electron-squirrel-startup": "1.0.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "electron": "44.4.5"
  },
  "config": {
    "forge": "./forge.config.cjs"
  }
}
